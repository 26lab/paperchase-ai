{
  "name": "paperchase-ai",
  "productName": "PaperChase AI",
  "version": "1.2.5",
  "description": "Desktop cockpit for trading ATAS with Claude, with safety rules built into the bridge.",
  "author": "26lab",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:26lab/paperchase-ai",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/build-electron.mjs",
    "start": "electron .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "bot:dry-run": "esbuild scripts/bot-dry-run.ts --bundle --platform=node --format=esm --outfile=dist-electron/bot-dry-run.mjs --log-level=warning && node dist-electron/bot-dry-run.mjs",
    "backtest": "esbuild scripts/backtest.ts --bundle --platform=node --format=esm --outfile=dist-electron/backtest.mjs --log-level=warning && node dist-electron/backtest.mjs",
    "dist": "npm run check && npm run build && electron-builder --win nsis",
    "release": "npm run check && npm run build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "io.26lab.paperchase",
    "publish": [
      {
        "provider": "github",
        "owner": "26lab",
        "repo": "paperchase-ai",
        "releaseType": "release"
      }
    ],
    "productName": "PaperChase AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "!dist-electron/*.map",
      "!dist-electron/backtest.mjs",
      "!dist-electron/bot-dry-run.mjs",
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/mcp.mjs"
    ],
    "extraResources": [
      {
        "from": "resources/bridge",
        "to": "bridge"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "resources/installer.nsh"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@oxlint/binding-win32-x64-msvc": "^1.90.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
